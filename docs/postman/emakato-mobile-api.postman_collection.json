            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_channel\": \"{{payment_channel}}\",\n  \"corporate_reference\": \"{{corporate_reference}}\",\n  \"phone\": \"{{customer_phone}}\",\n  \"email\": \"{{customer_email}}\",\n  \"account_name\": \"{{customer_name}}\",\n  \"account_number\": \"{{customer_account_number}}\",\n  \"NIN\": \"{{customer_nin}}\",\n  \"address\": \"Dar es Salaam\",\n  \"total_amount\": \"{{total_amount}}\",\n  \"debit_type\": \"FIXED\",\n  \"installment_amount\": \"{{installment_amount}}\",\n  \"periodicity\": \"MONTHLY\",\n  \"deduction_start_date\": \"{{deduction_start_date}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || {};",
                  "const mandate = data.mandate || {};",
                  "const reference = data.mandate_reference || mandate.reference || mandate.mandate_reference;",
                  "const uuid = data.mandate_uuid || mandate.uuid || mandate.mandate_uuid;",
                  "if (reference) pm.environment.set('mandate_reference', reference);",
                  "if (uuid) pm.environment.set('mandate_uuid', uuid);",
                  "pm.test('Request completed', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 400, 422, 500]);",
                  "});"
                ]
              }
            }
          ]
